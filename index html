<body class="bg-slate-50 text-slate-800 flex flex-col min-h-screen">

    <!-- HEADER / NAVIGATION -->
    <header class="bg-slate-900 text-white border-b-4 border-amber-500 sticky top-0 z-50">
        <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
            <div>
                <a href="index.html" class="font-extrabold text-lg text-white">GREAT STAND</a>
                <span class="block text-xs text-amber-400 font-semibold tracking-wider">EDUCATIONAL CONSULT</span>
            </div>
            <div>
                <a href="login.html" class="bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold px-4 py-2 rounded-lg text-sm transition">
                    Portal Login
                </a>
            </div>
        </div>
    </header>

    <!-- HERO SECTION -->
    <section class="bg-slate-900 text-white py-12 px-4 text-center">
        <div class="max-w-3xl mx-auto">
            <span class="bg-amber-500/20 text-amber-400 border border-amber-500/30 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">
                Founded November 2024
            </span>
            <h1 class="text-3xl md:text-5xl font-extrabold mt-4 mb-4 leading-tight">
                Guiding Students. <br><span class="text-amber-400">Building Futures.</span>
            </h1>
            <p class="text-slate-300 text-sm md:text-base mb-6 leading-relaxed">
                Comprehensive WAEC & JAMB preparation, university admission guidance, and interactive CBT testing designed for modern success.
            </p>
            <div class="flex flex-col sm:flex-row gap-3 justify-center">
